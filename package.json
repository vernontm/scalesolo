{
  "name": "scalesolo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ScaleSolo — the AI-native operating system for solopreneurs.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bundle-solana.mjs",
    "build": "npm run lint && vite build",
    "build:no-lint": "node scripts/bundle-solana.mjs && vite build",
    "bundle:solana": "node scripts/bundle-solana.mjs",
    "preview": "vite preview --port 5180",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:overlay-sync": "node scripts/smoke-overlay-renderer.mjs",
    "sync-logos": "node scripts/sync-brand-logos.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg/core": "^0.10.0",
    "@ffmpeg/ffmpeg": "^0.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^8.40.0",
    "@sentry/react": "^8.40.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@sparticuz/chromium": "^148.0.0",
    "@supabase/supabase-js": "^2.104.0",
    "@vercel/functions": "^3.7.6",
    "@xyflow/react": "^12.3.5",
    "bs58": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.0.11",
    "lucide-react": "^0.445.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "puppeteer-core": "^25.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": "20.x"
  }
