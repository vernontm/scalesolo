# Copy to watchdog/.env and fill in. NEVER commit the real .env (it is gitignored).

# ScaleSolo Supabase (project vbvmfiepwyxlfafbwtkb). Read-only use here.
# Service-role key reads the notifications table regardless of RLS.
SUPABASE_URL=https://vbvmfiepwyxlfafbwtkb.supabase.co
SUPABASE_SERVICE_KEY=

# Apify API token (apify.com > Settings > Integrations > API token).
APIFY_TOKEN=

# Where URGENT alerts go. Phone number (iMessage-capable) or an iMessage email.
# Example: +18327020514
ALERT_IMESSAGE_TO=

# Which platforms to check (comma-separated). Reliable set: tiktok,instagram,youtube
PLATFORMS=tiktok,instagram,youtube

# Flag posts that have no hashtags. Set to false to only flag empty/junk captions.
REQUIRE_HASHTAGS=true

# Keep retrying a not-yet-indexed post for this many minutes before giving up.
RETRY_WINDOW_MIN=25

# On first ever run, look back this many minutes for already-published posts.
FIRST_RUN_LOOKBACK_MIN=15
