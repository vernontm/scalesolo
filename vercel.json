{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/|studio-compositions/|free-blueprint|build-your-ai-empire|done-for-you|welcome|oto|media/|downloads/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/credit-monthly-reset", "schedule": "0 6 * * *" },
    { "path": "/api/admin/affiliates-close",    "schedule": "0 7 * * *" },
    { "path": "/api/cron/sweep-stale-renders",  "schedule": "*/15 * * * *" },
    { "path": "/api/cron/sync-scheduled-posts", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/distill-brand-voice",  "schedule": "30 6 * * *" },
    { "path": "/api/cron/run-scheduled-workflows", "schedule": "* * * * *" },
    { "path": "/api/cron/run-carousel-jobs", "schedule": "* * * * *" },
    { "path": "/api/cron/cleanup-uploadpost-orphans", "schedule": "*/30 * * * *" }
  ],
  "functions": {
    "api/carousels/process.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "api/_fonts/**"
    },
    "api/videos/combine.js": {
      "includeFiles": "node_modules/@ffmpeg/core/**",
      "maxDuration": 300,
      "memory": 3008
    },
    "api/videos/polish.js": {
      "includeFiles": "{node_modules/@ffmpeg-installer/**,api/_fonts/**}",
      "maxDuration": 300,
      "memory": 3008
    },
    "api/studio/render-final.js": {
      "maxDuration": 15
    },
    "api/studio/generate-assets.js": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/silence-400ms.mp3"
    },
    "api/voices/preview.js": {
      "includeFiles": "api/_lib/silence-400ms.mp3"
    },
    "api/avatars/render.js": {
      "includeFiles": "api/_lib/silence-400ms.mp3"
    },
    "api/avatars/synth-script.js": {
      "includeFiles": "api/_lib/silence-400ms.mp3"
    },
    "api/avatars/photo-render.js": {
      "includeFiles": "api/_lib/silence-400ms.mp3"
    },
    "api/studio/enrich-overlays.js": {
      "maxDuration": 120
    },
    "api/studio/refresh-motion-graphics.js": {
      "maxDuration": 120
    },
    "api/studio/segments/upload-avatar.js": {
      "maxDuration": 10
    },
    "api/studio/voiceover/upload.js": {
      "maxDuration": 10
    },
    "api/studio/voiceover/segment.js": {
      "includeFiles": "node_modules/@ffmpeg-installer/**",
      "maxDuration": 300,
      "memory": 1024
    },
    "api/studio/generate-map.js": {
      "maxDuration": 120
    },
    "api/studio/chat.js": {
      "maxDuration": 60
    },
    "api/social/upload-post.js": {
      "maxDuration": 60
    },
    "api/payouts.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/@babel/**,node_modules/@noble/**,node_modules/@solana/**,node_modules/@swc/**,node_modules/agentkeepalive/**,node_modules/ansi-styles/**,node_modules/base-x/**,node_modules/base64-js/**,node_modules/bigint-buffer/**,node_modules/bignumber.js/**,node_modules/bindings/**,node_modules/bn.js/**,node_modules/borsh/**,node_modules/bs58/**,node_modules/buffer/**,node_modules/chalk/**,node_modules/color-convert/**,node_modules/color-name/**,node_modules/commander/**,node_modules/delay/**,node_modules/es6-promise/**,node_modules/es6-promisify/**,node_modules/eventemitter3/**,node_modules/eyes/**,node_modules/fast-stable-stringify/**,node_modules/file-uri-to-path/**,node_modules/has-flag/**,node_modules/humanize-ms/**,node_modules/ieee754/**,node_modules/isomorphic-ws/**,node_modules/jayson/**,node_modules/json-stringify-safe/**,node_modules/ms/**,node_modules/node-fetch/**,node_modules/rpc-websockets/**,node_modules/stream-chain/**,node_modules/stream-json/**,node_modules/superstruct/**,node_modules/supports-color/**,node_modules/text-encoding-utf-8/**,node_modules/tr46/**,node_modules/tslib/**,node_modules/undici-types/**,node_modules/uuid/**,node_modules/webidl-conversions/**,node_modules/whatwg-url/**,node_modules/ws/**}"
    }
  }
}
