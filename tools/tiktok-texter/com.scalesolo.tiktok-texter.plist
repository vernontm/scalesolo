<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent: run the TikTok Draft texter every 5 minutes.
     Setup:
       1. Edit the two __PLACEHOLDER__ paths below (node binary + texter.mjs).
       2. Copy to ~/Library/LaunchAgents/com.scalesolo.tiktok-texter.plist
       3. launchctl load ~/Library/LaunchAgents/com.scalesolo.tiktok-texter.plist
     Find your node path with:  which node
     Unload later with:  launchctl unload ~/Library/LaunchAgents/com.scalesolo.tiktok-texter.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.scalesolo.tiktok-texter</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__TEXTER_MJS_PATH__</string>
  </array>

  <!-- Run every 5 minutes. launchd also fires once shortly after login. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>

  <!-- Logs (optional; handy while confirming it works). -->
  <key>StandardOutPath</key>
  <string>/tmp/scalesolo-tiktok-texter.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/scalesolo-tiktok-texter.log</string>
</dict>
</plist>
